# Copy to .env.production; fill required values locally. No real values here.
# Immutable app reference, e.g. an approved registry/repo@sha256:<digest>.
WITOP_APP_IMAGE=
# Approved official Nginx image reference, preferably pinned by digest.
NGINX_IMAGE=
# REQUIRED fixed container path: /run/secrets/sqlserver_config.json
SQLSERVER_CONFIG=
# Absolute path to existing external SQL JSON; never copy it into this checkout.
SQLSERVER_CONFIG_FILE=
# External htpasswd file; provision through the operator's secret system.
NGINX_AUTH_FILE=
# Optional: blank uses 127.0.0.1:80. For remote access bind a VPN/private IP only.
# For isolated local acceptance, set HTTP_PORT=8912 if port 80 is occupied.
HTTP_BIND=
HTTP_PORT=
# Operator curl auth file path only; set separately in the current shell for curl.
WITOP_CURL_AUTH_FILE=
